# xAI / Grok, using OpenAI-compatible chat completions
AGENT_LLM_PROVIDER=xai
AGENT_LLM_MODEL=grok-4.7
XAI_API_KEY=replace-me

# OpenRouter, using its OpenAI-compatible API
# AGENT_LLM_PROVIDER=openrouter
# AGENT_LLM_MODEL=replace-with-openrouter-model-slug
# OPENROUTER_API_KEY=replace-me

# LiteLLM proxy, useful when you want one internal gateway with budgets,
# retries, fallbacks, logs, and model aliases.
# AGENT_LLM_PROVIDER=litellm
# AGENT_LLM_BASE_URL=http://localhost:4000/v1
# AGENT_LLM_MODEL=replace-with-litellm-model-alias
# LITELLM_API_KEY=replace-me

# Generic OpenAI-compatible provider
# AGENT_LLM_PROVIDER=openai-compatible
# AGENT_LLM_BASE_URL=https://provider.example.com/v1
# AGENT_LLM_MODEL=provider-model-name
# AGENT_LLM_API_KEY_ENV=LLM_API_KEY
# LLM_API_KEY=replace-me
